# Valores preenchidos nas provisions pelo deploy-acs.js.
# Copie para acs.env (não vai para o Git) e preencha.

# API NBI do GenieACS
NBI_URL=http://127.0.0.1:7557

# URL do ACS gravada nos roteadores
ACS_URL=http://acs.exemplo.com.br:7547/

# Usuário e senha do Connection Request gravados nos roteadores
CR_USER=admin
CR_PASS=

# Arquivo baixado no teste de velocidade (TR-143)
SPEEDTEST_URL=http://acs.exemplo.com.br/100MB.bin

# Servidor NTP gravado nos roteadores
NTP_SERVER=192.168.10.1

# Pasta das extensões (usada com --install-ext)
GENIEACS_EXT_DIR=/opt/genieacs/ext
