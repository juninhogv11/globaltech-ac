# Configuração das extensões "sistema" (SGP) e "wifibackup", lida a cada consulta.
# No servidor do GenieACS: copie para /opt/genieacs/sgp.env e proteja:
#   chown genieacs:genieacs /opt/genieacs/sgp.env && chmod 600 /opt/genieacs/sgp.env

# API do SGP
SGP_HOST=suaempresa.sgp.net.br
SGP_APP=
SGP_TOKEN=

# Endereço do portal (a extensão wifibackup busca a cópia do Wi-Fi aqui)
WIFI_PORTAL_URL=http://192.168.10.3:8080
